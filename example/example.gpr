with "../sml.gpr";

project Example is

   --  TRACE picks the Trace_Config package (cfg/on or cfg/off) that sets the
   --  example's Debug actual, so the example can be built both ways.
   type Trace_Mode is ("on", "off");
   Trace : Trace_Mode := external ("TRACE", "off");

   for Source_Dirs use ("src", "cfg/" & Trace);
   --  Per-mode object and exec dirs (obj/<mode>, bin/<mode>) so switching TRACE
   --  never reuses stale artifacts -- gprbuild's incremental build can miss the
   --  cfg/on <-> cfg/off source-dir swap, so without this a rebuild after a
   --  switch needs a manual clean.
   for Object_Dir use "obj/" & Trace;
   for Exec_Dir use "bin/" & Trace;
   for Main use
     ("hello_world.adb",
      "hello_world_with_tracing.adb",
      "simple_turnstile.adb",
      "orthogonal_regions.adb",
      "run_to_completion.adb",
      "deferred_events.adb",
      "composite_states.adb",
      "bundled_context.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-g", "-gnata", "-gnatwa", "-gnatwe", "-gnat2022");
   end Compiler;

end Example;
